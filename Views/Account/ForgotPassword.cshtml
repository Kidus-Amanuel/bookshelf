@model BookShelf.ViewModels.Auth.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    var visual = new BookShelf.ViewModels.Auth.AuthVisualViewModel
    {
        Eyebrow = "Account recovery",
        Heading = "Let's get you back in.",
        Copy = "Enter the email on your account and we'll send you a link to reset your password.",
        ShowStats = false
    };
}

<div class="auth-shell">
    <partial name="_AuthVisual" model="visual" />

    <section class="auth-panel">
        <div class="panel-inner">
            <div class="brand-row">
                <div class="brand-badge">B</div>
                <div>
                    <div class="mini-label">Books &amp; stories</div>
                    <h1>BookShelf</h1>
                </div>
            </div>

            <div class="heading-block">
                <p class="eyebrow">Reset password</p>
                <h3>Forgot your password?</h3>
            </div>

            <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="field-group">
                    <label asp-for="Email">Email address</label>
                    <div class="input-shell">
                        <input asp-for="Email" type="email" placeholder="you@example.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-block">Send reset link</button>
            </form>

            <p class="signup-text">
                Remembered your password? <a asp-controller="Account" asp-action="Login" class="text-link">Back to sign in</a>
            </p>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
