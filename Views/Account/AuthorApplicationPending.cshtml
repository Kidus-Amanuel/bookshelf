@{
    ViewData["Title"] = "Application Pending";
    var visual = new BookShelf.ViewModels.Auth.AuthVisualViewModel
    {
        Eyebrow = "Application Received",
        Heading = "We're reviewing your application.",
        Copy = "Thank you for your interest in publishing on BookShelf. Our team will review your application shortly.",
        ShowStats = false
    };
}

<div class="auth-shell">
    <partial name="_AuthVisual" model="visual" />

    <section class="auth-panel">
        <div class="panel-inner">
            <div class="brand-row">
                <div class="brand-badge">B</div>
                <div>
                    <div class="mini-label">Books &amp; stories</div>
                    <h1>BookShelf</h1>
                </div>
            </div>

            <div class="heading-block">
                <p class="eyebrow">Status</p>
                <h3>Application Pending</h3>
            </div>

            <div class="empty-state">
                <p>Your application to become an author has been submitted successfully.</p>
                <p>An admin will review it soon. Once approved, you will have access to the author dashboard to start publishing your books.</p>
            </div>

            <div style="margin-top: 2rem;">
                <a asp-controller="Home" asp-action="Customer" class="btn btn-primary btn-block">Return to Dashboard</a>
            </div>
        </div>
    </section>
</div>
