@model BookShelf.ViewModels.Auth.BecomeAuthorViewModel
@{
    ViewData["Title"] = "Become an Author";
    var visual = new BookShelf.ViewModels.Auth.AuthVisualViewModel
    {
        Eyebrow = "Publish your work",
        Heading = "Share your stories with the world.",
        Copy = "Apply to become an author and reach thousands of readers on BookShelf.",
        ShowStats = false
    };
}

<div class="auth-shell">
    <partial name="_AuthVisual" model="visual" />

    <section class="auth-panel">
        <div class="panel-inner">
            <div class="brand-row">
                <div class="brand-badge">B</div>
                <div>
                    <div class="mini-label">Books &amp; stories</div>
                    <h1>BookShelf</h1>
                </div>
            </div>

            <div class="heading-block">
                <p class="eyebrow">Apply</p>
                <h3>Become an author</h3>
            </div>

            <form asp-controller="Account" asp-action="BecomeAuthor" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="field-group">
                    <label asp-for="PenName">Pen Name</label>
                    <div class="input-shell">
                        <input asp-for="PenName" placeholder="Your author name" />
                    </div>
                    <span asp-validation-for="PenName" class="field-error"></span>
                </div>

                <div class="field-group">
                    <label asp-for="Bio">Biography</label>
                    <div class="input-shell">
                        <textarea asp-for="Bio" placeholder="Tell us about yourself and what you write..." rows="4" style="width: 100%; border: none; outline: none; background: transparent; padding: 12px; resize: vertical;"></textarea>
                    </div>
                    <span asp-validation-for="Bio" class="field-error"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-block">Submit Application</button>
            </form>

            <p class="signup-text">
                <a asp-controller="Home" asp-action="Customer" class="text-link">Back to Dashboard</a>
            </p>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
