@model BookShelf.ViewModels.Admin.MembersViewModel
@{
    ViewData["Title"] = "Members";
    var hasFilter = !string.IsNullOrWhiteSpace(Model.FilterRole);
    var hasSearch = !string.IsNullOrWhiteSpace(Model.SearchTerm);
}

<div class="dashboard-shell">
    <partial name="_AdminSidebar" />

    <main class="dashboard-main">
        <header class="dashboard-topbar">
            <div>
                <p class="eyebrow">Admin &middot; Operations</p>
                <h1>Members</h1>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                <button type="submit" class="btn btn-secondary">Sign out</button>
            </form>
        </header>

        @if (TempData["Success"] != null)
        {
            <div class="pill pill-success" style="margin-bottom: 1.5rem; padding: 0.6rem 1rem; width: 100%;">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="validation-summary" style="margin-bottom: 1.5rem;">
                @TempData["Error"]
            </div>
        }

        <section class="dashboard-stats">
            <div class="stat-card">
                <span class="stat-card-label">Total members</span>
                <strong class="stat-card-value">@Model.TotalCount</strong>
                <small class="stat-card-meta">all registered users</small>
            </div>
            <div class="stat-card">
                <span class="stat-card-label">Customers</span>
                <strong class="stat-card-value">@Model.CustomerCount</strong>
                <small class="stat-card-meta">reader accounts</small>
            </div>
            <div class="stat-card">
                <span class="stat-card-label">Approved authors</span>
                <strong class="stat-card-value">@Model.ApprovedAuthorCount</strong>
                <small class="stat-card-meta @(Model.PendingAuthorCount > 0 ? "is-warning" : "")">
                    @Model.PendingAuthorCount pending application@(Model.PendingAuthorCount == 1 ? "" : "s")
                </small>
            </div>
            <div class="stat-card">
                <span class="stat-card-label">Admins &amp; staff</span>
                <strong class="stat-card-value">@(Model.AdminCount + Model.StaffCount)</strong>
                <small class="stat-card-meta">@Model.AdminCount admin &middot; @Model.StaffCount staff</small>
            </div>
        </section>

        @* ============ FILTERS ============ *@
        <section class="panel-card" style="margin-bottom: 1.5rem;">
            <div class="panel-header">
                <h3>Filter</h3>
                @if (hasFilter || hasSearch)
                {
                    <a asp-controller="Admin" asp-action="Users" class="btn btn-secondary btn-sm">Clear filters</a>
                }
            </div>
            <div style="padding: 0 1rem 1rem; display:flex; gap:1rem; flex-wrap:wrap; align-items:end;">
                <form asp-controller="Admin" asp-action="Users" method="get" style="display:flex; gap:.75rem; flex-wrap:wrap; align-items:end; flex:1;">
                    <div class="form-row" style="margin:0; flex:1; min-width:200px;">
                        <label for="q">Search name or email</label>
                        <input id="q" name="q" value="@Model.SearchTerm" class="form-control" placeholder="e.g. Carol or name@@domain" />
                    </div>
                    <div class="form-row" style="margin:0; min-width:180px;">
                        <label for="role">Role</label>
                        <select id="role" name="role" class="form-control">
                            <option value="">All roles</option>
                            @foreach (var r in Model.Roles)
                            {
                                <option value="@r.Name" selected="@(Model.FilterRole == r.Name ? "selected" : null)">@r.Name</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Apply</button>
                </form>
            </div>
        </section>

        @* ============ TABLE ============ *@
        <section class="panel-card large" style="margin:0;">
            <div class="panel-header">
                <h3>
                    Members
                    @if (hasFilter || hasSearch)
                    {
                        <small class="text-muted" style="font-weight:400;">
                            (filter:
                            @if (hasFilter) { <span>role = @Model.FilterRole</span> }
                            @if (hasFilter && hasSearch) { <span> &middot; </span> }
                            @if (hasSearch) { <span>search = "@Model.SearchTerm"</span> }
                            )
                        </small>
                    }
                </h3>
                <span class="info-pill">@Model.Users.Count result@(Model.Users.Count == 1 ? "" : "s")</span>
            </div>

            @if (!Model.Users.Any())
            {
                <p class="text-muted" style="padding:1rem;">No members match your filter.</p>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Member</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Profiles</th>
                            <th>Activity</th>
                            <th>Joined</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <div style="display:flex; align-items:center; gap:.6rem;">
                                        <div class="avatar-circle" style="background:@GetAvatarColor(user.Id)">@GetInitials(user.FullName)</div>
                                        <div>
                                            <strong>@user.FullName</strong>
                                            <div class="text-muted" style="font-size:.75rem;">#@user.Id</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-muted">@user.Email</td>
                                <td>
                                    <span class="badge @RoleBadge(user.Role?.Name)">@user.Role?.Name</span>
                                </td>
                                <td>
                                    @if (user.AuthorProfile != null)
                                    {
                                        var apBadge = user.AuthorProfile.Status switch
                                        {
                                            "Approved" => "badge-approved",
                                            "Pending" => "badge-pending",
                                            "Rejected" => "badge-rejected",
                                            "Suspended" => "badge-rejected",
                                            _ => "badge-neutral"
                                        };
                                        <span class="badge @apBadge" title="@user.AuthorProfile.PenName">Author (@user.AuthorProfile.Status)</span>
                                    }
                                    @if (user.StaffProfile != null)
                                    {
                                        <span class="badge badge-neutral">Staff@(user.StaffProfile.Branch != null ? $" @ {user.StaffProfile.Branch.Name}" : "")</span>
                                    }
                                    @if (user.AuthorProfile == null && user.StaffProfile == null)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-muted">
                                    <span>@(user.Orders?.Count ?? 0) orders</span>
                                    <span> &middot; </span>
                                    <span>@(user.Loans?.Count ?? 0) loans</span>
                                    <span> &middot; </span>
                                    <span>@(user.Subscriptions?.Count ?? 0) subs</span>
                                </td>
                                <td class="text-muted">@user.CreatedAt.ToString("MMM d, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    </main>
</div>

@functions {
    string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return (parts[0].Substring(0, 1) + parts[^1].Substring(0, 1)).ToUpper();
    }

    string GetAvatarColor(int id)
    {
        var colors = new[] { "#2563eb", "#7c3aed", "#db2777", "#16a34a", "#ea580c", "#0891b2", "#9333ea" };
        return colors[id % colors.Length];
    }

    string RoleBadge(string? role) => role switch
    {
        "Admin" => "badge-rejected",
        "Staff" => "badge-neutral",
        "Customer" => "badge-approved",
        _ => "badge-neutral"
    };
}

<style>
    .form-row { display:flex; flex-direction:column; gap:.4rem; }
    .form-row label { font-weight:600; font-size:.85rem; color:var(--text,#1f2937); }
    .form-control { padding:.55rem .75rem; border:1px solid var(--border,#d4d4d8); border-radius:8px; font-size:.95rem; background:#fff; color:inherit; }
    .form-control:focus { outline:none; border-color:var(--accent,#2563eb); box-shadow:0 0 0 3px rgba(37,99,235,.15); }
    .avatar-circle { width:36px; height:36px; border-radius:50%; color:#fff; display:inline-flex; align-items:center; justify-content:center; font-weight:600; font-size:.8rem; }
</style>