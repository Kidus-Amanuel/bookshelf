@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-shell">
    <aside class="dashboard-sidebar">
        <div class="sidebar-brand">
            <div class="brand-badge">B</div>
            <div>
                <div class="mini-label">Library</div>
                <h2>BookShelf</h2>
            </div>
        </div>

        <nav class="sidebar-nav">
            <a class="nav-item active" href="#">Overview</a>
            <a class="nav-item" asp-controller="Books" asp-action="Index">Books</a>
            <a class="nav-item" asp-controller="Loans" asp-action="Index">Loans</a>
            <a class="nav-item" asp-controller="Account" asp-action="Login">Sign out</a>
        </nav>
    </aside>

    <main class="dashboard-main">
        <header class="dashboard-topbar">
            <div>
                <p class="eyebrow">Dashboard</p>
                <h1>Welcome back, Kidus</h1>
            </div>
            <a asp-controller="Account" asp-action="Login" class="btn btn-secondary">Sign out</a>
        </header>

        <section class="stats-grid dashboard-stats">
            <div class="stat-card">
                <span>Total books</span>
                <strong>12,480</strong>
                <small>+8.2% this month</small>
            </div>
            <div class="stat-card">
                <span>Active loans</span>
                <strong>842</strong>
                <small>+14 new loans</small>
            </div>
            <div class="stat-card">
                <span>Members</span>
                <strong>1,860</strong>
                <small>+90 this week</small>
            </div>
            <div class="stat-card">
                <span>Revenue</span>
                <strong>$24.6k</strong>
                <small>+12.4% conversion</small>
            </div>
        </section>

        <section class="dashboard-panels">
            <div class="panel-card large">
                <div class="panel-header">
                    <h3>Reading progress</h3>
                    <span class="info-pill">This month</span>
                </div>
                <div class="progress-list">
                    <div class="progress-row">
                        <label>Fiction</label>
                        <div class="progress-bar"><span style="width:78%"></span></div>
                        <strong>78%</strong>
                    </div>
                    <div class="progress-row">
                        <label>History</label>
                        <div class="progress-bar"><span style="width:63%"></span></div>
                        <strong>63%</strong>
                    </div>
                    <div class="progress-row">
                        <label>Science</label>
                        <div class="progress-bar"><span style="width:91%"></span></div>
                        <strong>91%</strong>
                    </div>
                </div>
            </div>

            <div class="panel-card">
                <div class="panel-header">
                    <h3>Quick actions</h3>
                </div>
                <div class="quick-actions">
                    <a asp-controller="Books" asp-action="Create" class="action-btn">Add book</a>
                    <a asp-controller="Loans" asp-action="Borrow" class="action-btn">New loan</a>
                    <a asp-controller="Account" asp-action="Register" class="action-btn">Add member</a>
                </div>
            </div>
        </section>
    </main>
</div>
