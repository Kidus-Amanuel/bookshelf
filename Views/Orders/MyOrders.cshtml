@model IEnumerable<BookShelf.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="dashboard-shell">
    <partial name="_CustomerSidebar" />

    <main class="dashboard-main">
        <header class="dashboard-topbar">
            <div><p class="eyebrow">Account</p><h1>My orders</h1></div>
        </header>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <p>You haven't placed any orders yet.</p>
                <a asp-controller="Books" asp-action="Index" class="btn btn-primary">Browse books</a>
            </div>
        }
        else
        {
            <div class="panel-card large no-margin">
                <table class="data-table">
                    <thead>
                        <tr><th>Order</th><th>Date</th><th>Channel</th><th>Items</th><th>Total</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>#@order.Id</td>
                                <td>@order.CreatedAt.ToShortDateString()</td>
                                <td>@order.Channel</td>
                                <td>@order.OrderItems.Sum(i => i.Quantity)</td>
                                <td>$@order.TotalAmount.ToString("F2")</td>
                                <td>
                                    <span class="badge badge-@(order.Status.ToLower())">@order.Status</span>
                                </td>
                                <td><a asp-action="Details" asp-route-id="@order.Id" class="text-link">View</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </main>
</div>