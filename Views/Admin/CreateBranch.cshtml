@model BookShelf.Controllers.CreateBranchRequest
@{
    ViewData["Title"] = "Add branch";
}

<div class="dashboard-shell">
    <partial name="_AdminSidebar" />

    <main class="dashboard-main">
        <header class="dashboard-topbar">
            <div>
                <p class="eyebrow">Admin &middot; Operations</p>
                <h1>Add branch</h1>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                <button type="submit" class="btn btn-secondary">Sign out</button>
            </form>
        </header>

        @if (TempData["Error"] != null)
        {
            <div class="validation-summary" style="margin-bottom: 1.5rem;">
                @TempData["Error"]
            </div>
        }

        <section class="panel-card large" style="margin:0;">
            <div class="panel-header">
                <h3>New branch details</h3>
                <a asp-controller="Admin" asp-action="Branches" class="btn btn-secondary btn-sm">← Back to branches</a>
            </div>

            <div style="padding: 0 1rem 1.25rem;">
                <form asp-controller="Admin" asp-action="CreateBranch" method="post">
                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                    <div class="form-row">
                        <label for="Name">Branch name</label>
                        <input id="Name" name="Name" class="form-control" placeholder="Northside Library" required />
                    </div>

                    <div class="form-row">
                        <label for="Address">Address</label>
                        <input id="Address" name="Address" class="form-control" placeholder="123 Main St, City, State ZIP" />
                    </div>

                    <div class="form-row">
                        <label for="Phone">Phone</label>
                        <input id="Phone" name="Phone" class="form-control" placeholder="(555) 123-4567" />
                    </div>

                    <div style="display:flex; gap:.75rem; margin-top: 1rem;">
                        <button type="submit" class="btn btn-primary">Create branch</button>
                        <a asp-controller="Admin" asp-action="Branches" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </section>
    </main>
</div>

<style>
    .form-row { display:flex; flex-direction:column; gap:.4rem; margin-bottom: 1rem; }
    .form-row label { font-weight:600; font-size:.9rem; color:var(--text,#1f2937); }
    .form-control { padding:.6rem .8rem; border:1px solid var(--border,#d4d4d8); border-radius:8px; font-size:.95rem; background:#fff; color:inherit; }
    .form-control:focus { outline:none; border-color:var(--accent,#2563eb); box-shadow:0 0 0 3px rgba(37,99,235,.15); }
    .validation-summary { background:#fee2e2; color:#991b1b; padding:.75rem 1rem; border-radius:8px; margin-bottom:1rem; }
</style>