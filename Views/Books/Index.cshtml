@model IEnumerable<BookShelf.Models.Book>

@{
    ViewData["Title"] = "Books";
}

<h2>Books</h2>

<table>
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Category</th>
            <th>Available</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.Category</td>
                <td>@(book.IsAvailable ? "Yes" : "No")</td>
            </tr>
        }
    </tbody>
</table>
